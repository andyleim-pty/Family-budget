// Family Budget Tracker — data model
//
// Postgres (works well on Vercel + a managed provider like Neon or Supabase,
// since serverless hosting doesn't give you a persistent filesystem for
// SQLite). Point DATABASE_URL at your instance.
//
// NOTE: enum-like fields below are plain `String` columns rather than native
// Prisma enums — a holdover from when this schema targeted SQLite (whose
// connector doesn't support enums) that was kept for consistency when the
// datasource moved to Postgres. The allowed values for each are defined as
// TypeScript union types in src/lib/enums.ts — treat that file as the source
// of truth.
//
// Every household's data is isolated by `householdId` (see Household below).
// There's no self-serve signup yet — households are created via the seed
// script — but the isolation itself is already real: nothing queries across
// households, so this is the foundation multi-family/billing support would
// build on top of, not a retrofit. See README.md "Multiple households".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A billing/tenancy boundary — one per family using the app. Everything
/// else in the schema belongs to exactly one household, and every query in
/// the app is expected to filter by it (see src/lib/household.ts).
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users           User[]
  accounts        Account[]
  buckets         Bucket[]
  pockets         Pocket[]
  transactions    Transaction[]
  conversations   Conversation[]
  inboundMessages InboundMessage[]
}

/// A family member who can log in and/or send WhatsApp messages.
model User {
  id           String   @id @default(cuid())
  household    Household @relation(fields: [householdId], references: [id])
  householdId  String
  name         String
  email        String   @unique
  passwordHash String
  /// "OWNER" | "PARTNER" — see src/lib/enums.ts
  role         String   @default("PARTNER")
  // E.164 phone number used to identify inbound WhatsApp messages, e.g.
  // +61412345678. Globally unique (one real phone belongs to one person,
  // hence one household) — this is how an inbound WhatsApp message gets
  // resolved to a household without the sender saying who they are.
  whatsappPhone String? @unique
  createdAt    DateTime @default(now())

  transactions        Transaction[]
  pocketContributions PocketContribution[]
  inboundMessages     InboundMessage[]
  conversations       Conversation[]

  @@index([householdId])
}

/// A real-world bank/cash account. Buckets and Pockets are funded from one.
model Account {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  name        String
  institution String?
  /// "CHECKING" | "SAVINGS" | "CREDIT_CARD" | "CASH" — see src/lib/enums.ts
  type        String   @default("CHECKING")
  currency    String   @default("AUD")
  // Manually maintained running balance (live bank-feed sync is a future
  // integration point — see src/lib/bank-feed/README.md).
  balance     Decimal  @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  buckets      Bucket[]
  pockets      Pocket[]
  transactions Transaction[]

  @@index([householdId])
}

/// A recurring monthly budget category ("envelope"). Spending against a
/// bucket is compared to `monthlyLimit` for the current calendar month.
model Bucket {
  id          String  @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  name        String
  description String?
  /// "ESSENTIAL" | "DISCRETIONARY" | "MICRO" — see src/lib/enums.ts
  kind        String  @default("ESSENTIAL")
  monthlyLimit Decimal
  // Amount below which a transaction is auto-flagged as a "micro expense"
  // for reporting, regardless of which bucket it lands in.
  microThreshold Decimal @default(15)
  color       String   @default("#22c56b")
  icon        String   @default("wallet")
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([accountId])
  @@index([householdId])
}

/// A savings "sinking fund" pocket for things that are irregular but
/// predictable — holidays, festivities, trips, an emergency fund. Grows
/// over time via contributions rather than resetting monthly.
model Pocket {
  id           String    @id @default(cuid())
  household    Household @relation(fields: [householdId], references: [id])
  householdId  String
  name         String
  /// "HOLIDAY" | "FESTIVITY" | "TRIP" | "EMERGENCY" | "OTHER" — see src/lib/enums.ts
  goalType     String    @default("OTHER")
  targetAmount Decimal?
  targetDate   DateTime?
  // Suggested recurring monthly contribution to hit targetAmount by targetDate.
  monthlyContribution Decimal @default(0)
  currentAmount Decimal  @default(0)
  account      Account   @relation(fields: [accountId], references: [id])
  accountId    String
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  contributions PocketContribution[]

  @@index([accountId])
  @@index([householdId])
}

model PocketContribution {
  id            String   @id @default(cuid())
  pocket        Pocket   @relation(fields: [pocketId], references: [id], onDelete: Cascade)
  pocketId      String
  amount        Decimal
  note          String?
  contributedBy User?    @relation(fields: [userId], references: [id])
  userId        String?
  createdAt     DateTime @default(now())

  @@index([pocketId])
}

/// A single expense (or income/refund, via negative amount) posted against
/// a Bucket and drawn from an Account.
model Transaction {
  id         String   @id @default(cuid())
  // Denormalized from the Account/Bucket's household: every household-scoped
  // query filters directly on this column rather than relying on a join, so
  // one missed join condition elsewhere can't leak a transaction across
  // households.
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  amount     Decimal
  currency   String   @default("AUD")
  merchant   String?
  note       String?
  occurredAt DateTime @default(now())
  /// "MANUAL" | "WHATSAPP_IMAGE" | "WHATSAPP_AUDIO" | "WHATSAPP_TEXT" | "ASSISTANT_CHAT" | "IMPORT"
  source     String   @default("MANUAL")
  isMicro    Boolean  @default(false)
  // AI confidence (0-1) in the bucket assignment, null for manual entries.
  aiConfidence Float?
  aiRawNote    String? // raw transcript/receipt text kept for audit + re-categorization
  // Stable id for de-duplication on re-import: a bank/provider's own
  // transaction id for a live feed, or a content hash of
  // (account, date, amount, description) for a CSV statement import. Null
  // for manual/WhatsApp entries, which have no re-import to dedupe against.
  externalId String?

  bucket   Bucket? @relation(fields: [bucketId], references: [id])
  bucketId String?
  account  Account @relation(fields: [accountId], references: [id])
  accountId String
  loggedBy User?   @relation(fields: [userId], references: [id])
  userId   String?

  inboundMessage InboundMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bucketId])
  @@index([accountId])
  @@index([occurredAt])
  @@index([householdId])
  @@unique([accountId, externalId])
}

/// A conversation thread with the budget assistant — one per WhatsApp phone
/// number, or one per logged-in web user. Kept separate from InboundMessage
/// (which tracks expense-ingestion messages) so a running chat has its own
/// memory.
model Conversation {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  /// "WEB" | "WHATSAPP" — see src/lib/enums.ts
  channel   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  // Set for WHATSAPP conversations before/without a linked User.
  phone     String?
  // Extracted-but-not-yet-committed rows from a pasted statement or an
  // uploaded document (serialized CategorizedRow[] + a note — see
  // src/lib/bank-feed/import-rows.ts), while the assistant is waiting to
  // hear which account to file them under. Cleared once committed.
  pendingImportJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([phone])
  @@index([householdId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  /// "user" | "assistant"
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// Raw record of an inbound WhatsApp message, so the AI ingestion pipeline
/// is auditable and replies (e.g. "2" to pick bucket #2) can be resolved
/// against the most recent pending message from that sender.
model InboundMessage {
  id           String  @id @default(cuid())
  // Null until the sending phone number resolves to a linked User — an
  // unrecognized number can't be attributed to a household.
  household    Household? @relation(fields: [householdId], references: [id])
  householdId  String?
  waMessageId  String  @unique
  fromPhone    String
  user         User?   @relation(fields: [userId], references: [id])
  userId       String?
  /// "IMAGE" | "AUDIO" | "TEXT"
  kind         String
  mediaId      String?
  transcript   String?
  // Serialized CategorizationResult, kept while awaiting a bucket-choice
  // reply from the sender (e.g. "2") so the confirmation can complete the
  // transaction without re-running the AI extraction.
  extractedJson String?
  /// "RECEIVED" | "PROCESSING" | "NEEDS_CONFIRMATION" | "CONFIRMED" | "ANSWERED" | "FAILED"
  status       String  @default("RECEIVED")
  errorMessage String?

  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?      @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}
