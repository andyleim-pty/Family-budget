# --- Database -----------------------------------------------------------
# Postgres. For local dev, either run one yourself (e.g. `docker run -e
# POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`) or use a free Neon /
# Supabase project for both dev and production — same connection string
# shape either way.
DATABASE_URL="postgresql://user:password@localhost:5432/familybudget"

# --- Auth (NextAuth) ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed household + users (used by `npm run db:seed`) -------------------
HOUSEHOLD_NAME="Our household"
OWNER_NAME="Andy"
OWNER_EMAIL="andy@nessteams.com"
OWNER_PASSWORD="change-me-immediately"
OWNER_WHATSAPP_PHONE="+61400000000"

PARTNER_NAME="My Wife"
PARTNER_EMAIL="partner@example.com"
PARTNER_PASSWORD="change-me-immediately"
PARTNER_WHATSAPP_PHONE="+61400000001"

# --- Anthropic (receipt photo + text categorization) ----------------------
ANTHROPIC_API_KEY=""

# --- OpenAI (Whisper transcription for WhatsApp voice notes) --------------
# Optional: without this, voice notes get a friendly "please type or send a
# photo instead" reply. Text and photo ingestion work without it.
OPENAI_API_KEY=""

# --- WhatsApp Cloud API (Meta) --------------------------------------------
# See README.md "WhatsApp setup" for how to obtain these.
WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Proactive digests (daily/weekly WhatsApp push) -----------------------
# Any random string — required by /api/cron/* so only your scheduler can
# trigger a digest send. See README.md "Proactive digests".
CRON_SECRET=""
