# --- Database -----------------------------------------------------------
# SQLite by default (zero config). For production point this at Postgres
# and change the `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth) ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed users (used by `npm run db:seed`) -------------------------------
OWNER_NAME="Andy"
OWNER_EMAIL="andy@nessteams.com"
OWNER_PASSWORD="change-me-immediately"
OWNER_WHATSAPP_PHONE="+61400000000"

PARTNER_NAME="My Wife"
PARTNER_EMAIL="partner@example.com"
PARTNER_PASSWORD="change-me-immediately"
PARTNER_WHATSAPP_PHONE="+61400000001"

# --- Anthropic (receipt photo + text categorization) ----------------------
ANTHROPIC_API_KEY=""

# --- OpenAI (Whisper transcription for WhatsApp voice notes) --------------
# Optional: without this, voice notes get a friendly "please type or send a
# photo instead" reply. Text and photo ingestion work without it.
OPENAI_API_KEY=""

# --- WhatsApp Cloud API (Meta) --------------------------------------------
# See README.md "WhatsApp setup" for how to obtain these.
WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
